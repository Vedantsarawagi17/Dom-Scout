{
  "name": "dom-scout",
  "displayName": "DOM-Scout",
  "version": "2.1.0",
  "description": "A research tool to correlate DOM complexity with hardware performance.",
  "author": "Vedant Sarawagi",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "scripting",
      "sidePanel",
      "webRequest"
    ],
    "host_permissions": [
      "<all_urls>"  
    ],
    "web_accessible_resources": [
      {
        "resources": ["assets/tracker.js"],
        "matches": ["<all_urls>"]
      }
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}
